{% macro optgroup(name, options, selected) %}
  <optgroup label="{{name}}">
    {% for name, content in options %}
      {% if content is iterable %}
        {{ _self.optgroup(name, content) }}
      {% else %}
        <option value="{{name}}" {% if selected == name %}selected="selected"{% endif %}>{{content|raw}}</option>
      {% endif %}
    {% endfor %}
  </optgroup>
{% endmacro %}

{% macro select(attributes) %}
  {% set attributes = attributes|prepare_select %}
  {% if not attributes.id %}
    {% set id = random() %}
  {% else %}
    {% set id = attributes.id %}
  {% endif %}
  {% if not attributes._actions_in_wrapper and (attributes.itemtype or attributes.actions) %}
  <div data-dropdown-group class="d-flex flex-nowrap w-100 align-items-center {% if attributes.actions %}input-group{% endif %}">
  {% endif %}
  <select class='no-print form-select form-select-sm {{attributes.class}}' id="{{id}}" {{ attributes.multiple ? 'multiple="multiple"' : '' }}
    {% for name, value in attributes %}
      {% if name not in  ['_actions_in_wrapper', 'actions', 'values', 'value', 'class', 'multiple', 'condition', 'conditions', 'used', 'ajax', 'itemtype', 'entity_restrict', 'right', 'display_emptychoice', 'emptylabel', 'toadd', 'permit_select_parent', 'groups_id', 'inactive_deleted', 'with_no_right']%}
        {{name}}="{{value}}"
      {% endif %}
    {% endfor %}
    {% if attributes.name is defined %}
      aria-label="{{ attributes.name }}"
    {% endif %}>
    {% for key, item in attributes.values %}
      {% if item is iterable %}
        {{ _self.optgroup(key, item, attributes.value) }}
      {% else %}
        <option value="{{key}}" {% if attributes.value == key %}selected="selected"{% endif %}>{{item|raw}}</option>
      {% endif %}
    {% endfor %}
  </select>
  {% if not attributes._actions_in_wrapper and (attributes.itemtype or attributes.actions) %}
    {% include 'macros/dropdownActions.twig' with {'actions': attributes.actions} only %}
  </div>
  {% endif %}
  {% if attributes.noLib is not defined or attributes.noLib == false %}
  <script>
      $(function() {
        {% if attributes.ajax %}
            const params = {{attributes.ajax|json_encode|raw}};
            const data = params.data;
            params.dataType = 'json';
            params.delay = 250;
            params.data = function (params) {
                return {
                    searchText: params.term,
                    page: params.page || 1,
                    page_limit: 100,
                    ...data
                };
            };
        {% endif %}
        $.getScript('{{root_doc}}/node_modules/select2/dist/js/select2.min.js', function() {
            $('#{{attributes.id ? attributes.id : id}}').select2({
                theme: 'bootstrap-5',
                escapeMarkup: function(markup) {
                    return markup;
                },
                {% if attributes.ajax %}
                ajax: params,
                {% endif %}
                {% if attributes.multiple %}
                multiple: true,
                {% endif %}
            });
            {% if attributes.multiple %}
            let values = JSON.parse('{{attributes.value|json_encode|raw}}');
            if (values === null) {
                values = [];
            } else if (!Array.isArray(values) && typeof values === 'object') {
                values = Object.keys(values);
            }
            $('#{{attributes.id ? attributes.id : id}}')
                .val(values)
                .trigger('change');
            {% endif %}
        });
      });
  </script>
  {% endif %}
{% endmacro %}
{{ _self.select(attributes) }}
